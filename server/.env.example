# Copy to server/.env (setup.sh writes this for you on the server).
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://m114:CHANGE_ME@127.0.0.1:5432/m114
APP_URL=https://www.memorize114.com
# Comma-separated. These accounts become administrators when they register or sign in.
ADMIN_EMAILS=you@example.com
# Amazon SES for password-reset and confirmation emails. Leave blank to log emails instead.
MAIL_FROM=Memorize 114 <no-reply@memorize114.com>
SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
